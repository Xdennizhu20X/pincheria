generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                 String      @id @default(cuid())
  name               String
  category           String      // "PINCHO" | "BEBIDA"
  subCategory        String?     // "Personal", "1 Litro", "1.25 Litros", "2 Litros"
  price              Float
  imageUrl           String?
  description        String?
  hasAccompaniments  Boolean     @default(false)
  isActive           Boolean     @default(true)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  orderItems         OrderItem[]
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @unique
  tableNumber  String      // "Mesa 1", "Mesa 2", "Para Llevar", etc.
  customerName String?
  waiterName   String      @default("Mesero")
  status       String      @default("PENDIENTE_COCINA") // PENDIENTE_COCINA | DESPACHADO | PAGADO | CANCELADO
  total        Float       @default(0.0)
  notes        String?
  createdAt    DateTime    @default(now())
  dispatchedAt DateTime?
  paidAt       DateTime?
  items        OrderItem[]
  payment      Payment?
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  unitPrice     Float
  quantity      Int      @default(1)
  accompaniment String?  // Opción elegida: ej. "Arroz, papa, choclo, menestra"
  notes         String?
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         String   @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA
  amountReceived Float
  changeGiven    Float    @default(0.0)
  proofImage     String?  // Foto del comprobante de transferencia (opcional)
  createdAt      DateTime @default(now())
}
